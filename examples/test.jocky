// test.jocky - Full forensic DSL demo (all stdlib calls) per LANGUAGE_SPEC §11/18/19 + IR_SPEC
// Exercises investigation blocks, imports (quoted+dotted), func/function, filter/correlate, control flow — gaps now closed per GAPS.md
investigation "full_demo" {
  import "forensic.net";
  import forensic.process;
  func collect_host() {
    system.info();
    process.list();
  }
  function analyze_evidence() {
    file.hash("/evidence/sample.exe");
  }
  let info = system.info();
  let procs = process.list();
  let tree = process.tree();
  let mods = process.modules(1234);
  let files = file.list("/tmp");
  let meta = file.metadata("/tmp/a.exe");
  let h = file.hash("/tmp/a.exe");
  let verdict = file.analyze("/tmp/a.exe");
  let ifs = network.interfaces();
  let conns = network.connections();
  let mem = memory.analyze(1234);
  let drivers = driver.list();
  let scan = driver.scan("RTCore64.sys");
  let risk = driver.risk("RTCore64.sys");
  // LANGUAGE_SPEC §12 filter, §15 correlate, §13-14 control flow
  filtered = filter(procs, procs.length > 0);
  correlated = correlate(procs, conns);
  if (risk > 70) {
    file.analyze("/tmp/suspicious.exe");
  }
  for (let i = 0; i < 2; i = i + 1) {
    network.connections();
  }
}
