# JOCKY Environment - copy to .env and set strong secrets per SECURITY_MODEL §28
# For lab: cp .env.example .env and edit JWT_SECRET/POSTGRES_PASSWORD
COMPOSE_PROJECT_NAME=jocky
# CHANGE THIS in prod — must not be default when AUTH_REQUIRED=true per backend/app/auth.py
JWT_SECRET=CHANGE_ME_TO_STRONG_RANDOM_32_CHARS_MIN
JWT_ALG=HS256
JWT_EXPIRE_SECONDS=3600
AUTH_REQUIRED=false
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_DB_PASSWORD
POSTGRES_DB=jockydb
POSTGRES_USER=jocky
DATABASE_URL=postgresql://jocky:${POSTGRES_PASSWORD}@db:5432/jockydb
CORS_ORIGINS=*
# For prod: CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
# JOCKY_PLATFORM=linux
